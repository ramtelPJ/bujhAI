// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProcessingStatus {
  uploaded
  processing
  ready
  failed
}

enum ActionStatus {
  required
  recommended
  not_required
  unknown
  deadline_passed
}

enum Urgency {
  critical
  high
  medium
  low
  unknown
}

enum CaseStatus {
  active
  completed
}

enum TaskStatus {
  pending
  completed
}

enum MessageRole {
  user
  assistant
}

enum DraftType {
  email
  letter
  response
}

/// Distinguishes what a document actually says from what the model filled in.
enum EvidenceState {
  explicit
  inferred
  unknown
  not_found
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents     Document[]
  cases         Case[]
  conversations Conversation[]
  drafts        Draft[]
  caseNotes     CaseNote[]

  @@map("users")
}

model Document {
  id               String           @id @default(cuid())
  userId           String
  fileName         String
  mimeType         String
  blobPath         String
  fileSize         Int
  pageCount        Int?
  processingStatus ProcessingStatus @default(uploaded)
  /// Client-generated per upload attempt; lets a retried/duplicated POST
  /// /api/documents return the already-created row instead of a duplicate.
  idempotencyKey   String?          @unique
  /// Private Blob path to the Feature 09 pipeline's normalized per-page text
  /// (JSON), set once parsing/OCR finishes. Derived content, not the original.
  extractedTextBlobPath String?
  /// User-safe message describing why processing failed, shown on the failed
  /// state. Never document contents — see authentiation-security.md §4.
  processingError  String?
  uploadedAt       DateTime         @default(now())
  deletedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  case Case?

  @@index([userId])
  @@map("documents")
}

model Case {
  id              String       @id @default(cuid())
  userId          String
  documentId      String       @unique
  documentType    String
  issuer          String?
  recipient       String?
  issueDate       DateTime?
  actionStatus    ActionStatus @default(unknown)
  urgency         Urgency      @default(unknown)
  summary         String
  primaryDeadline DateTime?
  status          CaseStatus   @default(active)
  uncertainties   String[]     @default([])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  document          Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  extractions       Extraction[]
  deadlines         Deadline[]
  tasks             Task[]
  requiredMaterials RequiredMaterial[]
  submissionMethods SubmissionMethod[]
  conversations     Conversation[]
  drafts            Draft[]
  notes             CaseNote[]

  @@index([userId])
  @@map("cases")
}

model Extraction {
  id            String        @id @default(cuid())
  caseId        String
  field         String
  value         Json
  confidence    Decimal
  evidenceState EvidenceState
  sourcePage    Int?
  sourceText    String?
  createdAt     DateTime      @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("extractions")
}

model Deadline {
  id          String   @id @default(cuid())
  caseId      String
  date        DateTime?
  description String
  confidence  Decimal
  sourcePage  Int?
  createdAt   DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("deadlines")
}

model Task {
  id          String     @id @default(cuid())
  caseId      String
  title       String
  description String
  required    Boolean
  dueDate     DateTime?
  status      TaskStatus @default(pending)
  sourcePage  Int?
  createdAt   DateTime   @default(now())
  completedAt DateTime?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("tasks")
}

model RequiredMaterial {
  id          String  @id @default(cuid())
  caseId      String
  name        String
  description String?
  required    Boolean
  sourcePage  Int?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("required_materials")
}

model SubmissionMethod {
  id            String  @id @default(cuid())
  caseId        String
  method        String
  destination   String?
  instructions  String?
  sourcePage    Int?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("submission_methods")
}

model Conversation {
  id        String   @id @default(cuid())
  caseId    String
  userId    String
  createdAt DateTime @default(now())

  case     Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([caseId])
  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model Draft {
  id        String    @id @default(cuid())
  caseId    String
  userId    String
  type      DraftType
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([userId])
  @@map("drafts")
}

model CaseNote {
  id        String   @id @default(cuid())
  caseId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([userId])
  @@map("case_notes")
}
